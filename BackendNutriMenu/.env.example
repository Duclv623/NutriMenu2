DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-postgres-password
# Optional database options used by setup/migration tools (Java database URLs keep module defaults).
DB_HOST=127.0.0.1
DB_PORT=5432
# Set these only when migrating the old PostgreSQL bridge before first login.
LEGACY_GATEWAY_POSTGRES_DSN=
LEGACY_GATEWAY_SCHEMA=gateway
